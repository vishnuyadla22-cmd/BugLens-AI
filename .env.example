# BugLens AI Configuration

# Backend Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama Local AI Configuration
# Default URL for Ollama local service
OLLAMA_BASE_URL=http://localhost:11434

# Recommended Open-Weight Coding Models:
# - qwen2.5-coder:7b (Recommended, strong reasoning and syntax awareness)
# - deepseek-coder:6.7b (Excellent competitive programming benchmark results)
# - codellama:7b (Fast & general purpose)
# - qwen2.5-coder:1.5b (Ultra-lightweight for low-RAM machines)
OLLAMA_MODEL=qwen2.5-coder:7b

# Inference Timeout in seconds
OLLAMA_TIMEOUT_SECONDS=120

# Execution Sandbox Settings
SANDBOX_EXECUTION_TIMEOUT_SECONDS=5.0
SANDBOX_MAX_OUTPUT_BYTES=65536

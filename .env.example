# BugLens AI Configuration

# Backend Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bug-lens-ai.vercel.app

# Frontend Environment Variable (set in Vercel or frontend/.env)
# VITE_API_URL=https://buglens-ai-p1ni.onrender.com

# Groq AI Configuration
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Recommended Supported Groq Models:
# - llama-3.3-70b-versatile (Recommended, powerful reasoning and syntax awareness)
# - llama-3.1-70b-versatile (Excellent coding benchmark results)
# - llama-3.1-8b-instant (Fast & lightweight)
GROQ_MODEL=llama-3.3-70b-versatile

# Inference Timeout in seconds
GROQ_TIMEOUT_SECONDS=60.0

# Execution Sandbox Settings
SANDBOX_EXECUTION_TIMEOUT_SECONDS=5.0
SANDBOX_MAX_OUTPUT_BYTES=65536
